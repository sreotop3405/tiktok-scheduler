# Telegram bot config (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID(s) allowed to use this bot. Comma-separated.
# Get yours at https://t.me/userinfobot
TELEGRAM_OWNER_IDS=
# Optional proxy for api.telegram.org if your ISP throttles/blocks Telegram
# (common in RU). Examples:
#   TELEGRAM_PROXY_URL=socks5://user:pass@host:1080
#   TELEGRAM_PROXY_URL=http://user:pass@host:8080
# TELEGRAM_PROXY_URL=

# Where SQLite DB and uploaded videos are stored
DATA_DIR=./data

# Web UI bind address (set to 0.0.0.0 inside containers)
WEB_HOST=127.0.0.1
WEB_PORT=8765

# Set to "true" to enable the optional web dashboard
WEB_ENABLED=true

# Default timezone for schedule windows shown in UI/bot
DEFAULT_TIMEZONE=Europe/Moscow

# Playwright: run browser headless during scheduled posting.
# For interactive `login` command we always force headed mode.
HEADLESS_POSTING=true

# Optional: override Chromium executable path used by Playwright
# CHROMIUM_PATH=

# Optional: per-account proxy is configured in DB; this is a global fallback
# PROXY_URL=

# Posting retry policy
MAX_POST_ATTEMPTS=3
RETRY_BACKOFF_MINUTES=15
